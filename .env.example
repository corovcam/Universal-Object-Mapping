# Production-only configuration
PRODUCTION_DOMAIN_OR_IP=
K8S_EXTERNAL_IP=            # For proxy tunnelling, leave out if not needed and remove chisel-tunnel service from docker-compose.prod.yml

# MFF Ollama server variables
XRG13_SSH_USERNAME=
XRG13_SSH_PRIVATE_KEY_PATH= # change to valid path

# Docker host ports
