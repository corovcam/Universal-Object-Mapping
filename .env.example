JAVA_SERVICE_PORT=8090
JAVA_SERVICE_SSH_PORT=8022
MONGODB_MIGRATOR_PORT=8091
DB_TOOLBOX_PORT=5010

# Database variables
MSSQL_PORT=1333
MSSQL_SA_USER=sa
MSSQL_SA_PASSWORD=Testingorms123
