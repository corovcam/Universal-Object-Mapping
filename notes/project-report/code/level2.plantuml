@startuml C4_Containers
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

!$ICONURL = "https://raw.githubusercontent.com/tupadr3/plantuml-icon-font-sprites/v3.0.0/icons"
!include $ICONURL/common.puml
!define DEVICONS2 $ICONURL/devicons2
!include DEVICONS2/python.puml
!include DEVICONS2/microsoftsqlserver.puml
!include DEVICONS2/mongodb.puml
!include DEVICONS2/neo4j.puml
!include DEVICONS2/postgresql.puml
!include DEVICONS2/redis.puml
!include DEVICONS2/dot_net.puml
!include DEVICONS2/java.puml

title UOM System - Container Diagram

Person(dev, "Developer / DB Architect", "Migrates schemas/queries.")

System_Boundary(uom, "Universal Object Mapping (UOM) System") {
    
    Container(frontend, "UOM UI Web App", "Next.js, Node.js", "Provides chat UI, streaming compiler logs, and DeepDiff visualization. Proxies API requests.")
    
    Container(orchestrator, "LangGraph Orchestrator", "Python, FastAPI", "Core deterministic translation pipeline. Manages LangGraph state machine, deep agent loops, and evaluation logic.", $sprite="python")
    
    Container(mcp_toolbox, "GenAI DB Toolbox MCP", "Python", "Provides Relational & Neo4j database inspection context to the Orchestrator.", $sprite="python")
    Container(mcp_mongo, "MongoDB MCP Server", "TypeScript", "Provides MongoDB database inspection context to the Orchestrator.")
    
    Container(daytona, "Daytona Daemon", "Go", "Spawns and manages isolated ephemeral sandbox environments.")
    
    Container(sandbox_dotnet, ".NET 10 Sandbox", "Docker", "Compiles C# models/queries and executes ADO.NET checks.", $sprite="dot_net")
    Container(sandbox_java, "Java 25 Sandbox", "Docker", "Compiles Spring Data models/queries and executes database checks.", $sprite="java")
    
    Boundary(db, "Databases") {
        ContainerDb(pg, "PostgreSQL", "Postgres + pgvector", "State checkpointing and vector embeddings.", $sprite="postgresql")
        ContainerDb(redis, "Redis", "Redis", "In-memory cache for the agent state.", $sprite="redis")
        ContainerDb(mssql, "MS SQL Server", "SQL Server 2022", "Source database (WideWorldImporters).", $sprite="microsoftsqlserver")
        ContainerDb(mongo, "MongoDB", "MongoDB 8", "Target document database.", $sprite="mongodb")
        ContainerDb(neo4j, "Neo4j", "Neo4j 2026", "Target graph database.", $sprite="neo4j")
    }
}

System_Ext(ollama_ext, "MFF UK Ollama Server", "Ollama")
System_Ext(einfra_ext, "E-Infra vLLM API", "vLLM")

Rel(dev, frontend, "Interacts with workspace", "HTTPS")

Rel(frontend, orchestrator, "Proxies requests (Runs/Threads)", "HTTP / SSE")

Rel(orchestrator, mcp_toolbox, "Inspects Schema", "MCP / Stdio")
Rel(orchestrator, mcp_mongo, "Inspects Schema", "MCP / Stdio")

Rel(orchestrator, daytona, "Spawns Sandboxes", "REST API")
Rel(daytona, sandbox_dotnet, "Manages container")
Rel(daytona, sandbox_java, "Manages container")

Rel(mcp_toolbox, mssql, "Inspects tables", "ADO.NET/ODBC")
Rel(mcp_toolbox, neo4j, "Inspects labels/relationships", "Bolt")
Rel(mcp_mongo, mongo, "Inspects collections", "Mongo Protocol")

Rel(sandbox_dotnet, mssql, "Executes query", "ADO.NET")
Rel(sandbox_java, mongo, "Executes query", "Spring Data")
Rel(sandbox_java, neo4j, "Executes query", "Spring Data")

Rel(orchestrator, pg, "Persists state", "SQL")
Rel(orchestrator, redis, "Caches", "Redis Protocol")

Rel(orchestrator, ollama_ext, "Uses LLM", "SSH Tunnel")
Rel(orchestrator, einfra_ext, "Uses LLM", "HTTPS")

SHOW_LEGEND()
@enduml