@startuml HIDE_STEREOTYPE SHOW_ELEMENT_TYPE C4_Containers

!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

!$ICONURL = "https://raw.githubusercontent.com/tupadr3/plantuml-icon-font-sprites/v3.0.0/icons"
!include $ICONURL/common.puml
!define DEVICONS2 $ICONURL/devicons2
!define FA6 $ICONURL/font-awesome-6
!include DEVICONS2/python.puml
!include FA6/microsoft.puml

SHOW_ELEMENT_TYPE()
HIDE_STEREOTYPE()

Component(api_server, "LangGraph Agent Server", "Python", "Provides REST/SSE endpoints for clients.", $sprite="python")

Boundary(orchestrator, "LangGraph Compiled State Graph (Orchestrator)") {
    Component(node_extract, "Extract Input Node", "Python", "Parses user query and frameworks into structured input.")
    Component(node_schema, "Schema Inspection Node", "Python", "Retrieves context via MCP DB tools.")
    Component(node_generate, "Generate Translation Node", "Python", "Generates source/target code representations with executable harnesses.")
    Component(node_val_schema, "Validate Schema Node", "Python", "Executes compiler and data query tools in sandboxes concurrently.")
    Component(node_val_query, "Validate Query Node", "Python", "Executes compiler and data query tools in sandboxes concurrently.")
    Component(node_equiv, "Check Equivalence Node", "Python", "Computes DeepDiff on executed query results.")
    Component(node_eval, "Evaluation Node", "Python", "LLM Judge reviewing diffs and logs to ACCEPT or REJECT with EXPLANATION.")
    Component(node_human, "Human Intervention Node", "Python", "Interrupts execution and waits for human feedback on MAX_LOOPS.")
    Component(node_finalize, "Finalization Node", "Python", "Finalizes the translation and returns the result to the client.")
}

System(sandboxes, "Daytona", "Executes sandbox environments.")
Boundary(mcp, "Tool Servers (MCP)", $descr="DB inspection tools; spring-docs search.")
System_Ext(llm, "LLM Providers", "E-Infra / Ollama / OpenAI-Compatible")
System_Ext(ms_learn, "Microsoft Learn MCP", "Remote MCP endpoint for .NET reference docs.")
System_Ext(tavily, "Tavily API", "Remote (general-purpose) Web Search API")

Rel(api_server, node_extract, "Starts graph")
Rel_Right(node_extract, node_schema, "Transitions (Inputs Present)")
Rel(node_schema, node_generate, "Transitions")
Rel(node_generate, node_val_schema, "Transitions (TranslationType=SCHEMA)")
Rel(node_generate, node_val_query, "Transitions (TranslationType=QUERY / BOTH)")
Rel_Left(node_val_schema, node_val_query, "Transitions (Passed & BOTH)")
Rel(node_val_query, node_equiv, "Transitions (Passed)")
Rel_Right(node_equiv, node_eval, "Transitions")
Rel_Left(node_eval, node_generate, "REJECT\n& Loop < Max")
Rel_Left(node_eval, node_human, "REJECT\n& Loop >= Max")
Rel(node_human, node_generate, "Resumes on user feedback")
Rel_Left(node_eval, node_finalize, "ACCEPT")

Rel(node_schema, mcp, "Delegates DB inspections")
Rel(node_generate, mcp, "Spring-docs documentation search")
Rel_Left(node_generate, ms_learn, "Delegates .NET documentation search")
Rel_Left(node_generate, tavily, "Delegates web search")
Rel(node_val_schema, sandboxes, "Triggers build execution")
Rel(node_val_query, sandboxes, "Triggers query execution")

Lay_Up(ms_learn, tavily)

Rel_Left(node_extract, llm, "Invokes")
Rel_Left(node_generate, llm, "Invokes")
Rel_Left(node_eval, llm, "Invokes")

@enduml
