# shellcheck disable=SC2148
if [[ -f ~/.envrc.local ]] && type source_env >/dev_null 2>&1; then
  source_env ~/.envrc.local
else
  source ~/.envrc.local
fi

SCRIPT_DIR="$(dirname "$0")"

if [ -d "$SCRIPT_DIR/.venv/bin" ]; then
  source "$SCRIPT_DIR/.venv/bin/activate"
elif [ -d "$SCRIPT_DIR/.venv/Scripts" ]; then
  source "$SCRIPT_DIR/.venv/Scripts/activate"
fi

HOST_GW="$(docker network inspect uom --format '{{(index .IPAM.Config 0).Gateway}}')"
export OUTER_HOST_GATEWAY_IP="$HOST_GW"

if type dotenv_if_exists >/dev/null 2>&1; then
  dotenv_if_exists .env.dev
else
  ./"$SCRIPT_DIR"/scripts/load_env.sh
fi
