{
	"name": "uom-translator-ui",
	"version": "0.1.0",
	"private": true,
	"engines": {
		"node": ">=24",
		"pnpm": ">=11"
	},
	"scripts": {
		"dev": "concurrently -k --kill-timeout 10000 --names frontend,backend,aimock 'pnpm run dev:frontend --inspect' './scripts/run-dev-backend.sh' 'cd ../../services/orchestrator && make record_requests'",
		"dev:frontend": "next dev --turbopack",
		"build": "next build",
		"start": "next start",
		"start-test": "concurrently -k --kill-timeout 10000 --names frontend,backend,aimock 'export PORT=3001 && export LANGGRAPH_API_URL=http://localhost:2024 && node .next/standalone/server.js' 'cd ../../services/orchestrator && bash .envrc && make dev'",
		"lint": "biome check .",
		"format": "biome format .",
		"format:fix": "biome format --write .",
		"lint:fix": "biome check --write ."
	},
	"dependencies": {
		"@assistant-ui/core": "^0.2.10",
		"@assistant-ui/react": "^0.14.14",
		"@assistant-ui/react-langgraph": "^0.14.6",
		"@assistant-ui/react-markdown": "^0.14.1",
		"@assistant-ui/react-streamdown": "^0.3.1",
		"@langchain/anthropic": "^1.4.0",
		"@langchain/langgraph": "^1.3.5",
		"@langchain/langgraph-sdk": "^1.9.16",
		"@opentelemetry/api": "^1.9.1",
		"@radix-ui/react-avatar": "^1.1.11",
		"@radix-ui/react-collapsible": "^1.1.12",
		"@radix-ui/react-dialog": "^1.1.15",
		"@radix-ui/react-separator": "^1.1.8",
		"@radix-ui/react-slot": "^1.2.4",
		"@radix-ui/react-tooltip": "^1.2.8",
		"@streamdown/code": "^1.1.1",
		"@streamdown/mermaid": "^1.0.2",
		"@uiw/react-json-view": "2.0.0-alpha.43",
		"@vercel/otel": "^2.1.2",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"langgraph-nextjs-api-passthrough": "^0.1.4",
		"lucide-react": "^1.17.0",
		"next": "^16.2.7",
		"next-themes": "^0.4.6",
		"partial-json": "^0.1.7",
		"radix-ui": "^1.4.3",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"react-shiki": "^0.10.1",
		"remark-gfm": "^4.0.1",
		"sonner": "^2.0.7",
		"streamdown": "^2.5.0",
		"tailwind-merge": "^3.6.0",
		"tw-animate-css": "^1.4.0",
		"tw-shimmer": "^0.4.11",
		"zod": "^4.4.3",
		"zustand": "^5.0.14"
	},
	"devDependencies": {
		"@assistant-ui/react-devtools": "^1.2.2",
		"@biomejs/biome": "^2.4.16",
		"@langchain/core": "^1.1.48",
		"@langchain/langgraph-cli": "^1.2.4",
		"@tailwindcss/postcss": "^4.3.0",
		"@types/node": "^25.9.1",
		"@types/react": "^19.2.16",
		"@types/react-dom": "^19.2.3",
		"concurrently": "^9.2.1",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3"
	},
	"packageManager": "pnpm@11.5.2",
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "^24.16.0",
			"onFail": "download"
		},
		"packageManager": {
			"name": "pnpm",
			"version": "11.5.2",
			"onFail": "download"
		}
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild",
			"sharp"
		]
	}
}
