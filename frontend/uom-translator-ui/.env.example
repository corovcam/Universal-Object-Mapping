# Frontend (Next.js proxy to LangGraph)
LANGGRAPH_API_URL=${LANGGRAPH_API_URL:-http://langgraph-api:8000}
# Forwarded as `x-api-key`. Leave blank for local dev.
LANGSMITH_API_KEY=
# Graph id. Must match a key under "graphs" in langgraph.json.
NEXT_PUBLIC_LANGGRAPH_ASSISTANT_ID=universal-object-mapping-translator
# Optional: ${LANGGRAPH_API_URL:-http://langgraph-api:8000} bypasses the /api proxy and lets the browser hit LangGraph directly.
# Leave unset to route everything through the Next.js proxy on the current host.
NEXT_PUBLIC_LANGGRAPH_API_URL=${NEXT_PUBLIC_LANGGRAPH_API_URL:-http://localhost:3020/api}
NEXT_PUBLIC_MONGODB_REL_MIGRATOR_URL=http://localhost:8091

# For vercel deployments, leave as is
ENABLE_EXPERIMENTAL_COREPACK=1

# Copied from orchestrator, but can be customized for frontend-specific needs (e.g. different LLM endpoint or model)
OLLAMA_HOST=http://ollama-autossh-tunnel:11434
MODEL=einfra/kimi-k2.6
OPENAI_API_URL=https://llm.ai.e-infra.cz/v1
OPENAI_API_KEY=
MSSQL_CONNECTION_STRING="Server=${OUTER_HOST_GATEWAY_IP:-host.docker.internal},1333;Database=WideWorldImporters;User Id=sa;Password=Testingorms123;TrustServerCertificate=True"
MONGODB_URI=mongodb://uom_readonly:uom_readonly@${OUTER_HOST_GATEWAY_IP:-host.docker.internal}:27027/uom
NEO4J_URI=neo4j://${OUTER_HOST_GATEWAY_IP:-host.docker.internal}:7697
NEO4J_PASSWORD=password
DAYTONA_TIMEOUT=480
DB_TOOLBOX_URI=http://db-toolbox:5000
MONGODB_MCP_URI=http://mongodb-mcp-server:3000/mcp
DAYTONA_API_KEY=
DAYTONA_API_URL=http://${OUTER_HOST_GATEWAY_IP:-host.docker.internal}:3000/api
DAYTONA_TARGET=us
